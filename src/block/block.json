{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "primiko/form",
  "version": "1.1.0",
  "title": "Quote request form",
  "category": "widgets",
  "icon": "clipboard",
  "description": "Shows one of your quote request forms.",
  "keywords": [
    "quote",
    "estimate",
    "form"
  ],
  "textdomain": "primiko",
  "attributes": {
    "formId": {
      "type": "integer",
      "default": 0
    },
    "accentColor": {
      "type": "string"
    },
    "radius": {
      "type": "integer"
    },
    "headingLevel": {
      "type": "integer",
      "default": 3
    },
    "width": {
      "type": "string",
      "enum": [ "reading", "full" ],
      "default": "reading"
    },
    "anchor": {
      "type": "string"
    },
    "columns": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {
    "html": false,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true,
      "padding": true
    },
    "typography": {
      "fontSize": true
    },
    "color": {
      "text": true,
      "background": true
    }
  },
  "editorScript": "file:./index.js"
}
