{
  "schema": 1,
  "id": "mason",
  "title": "Mason and builder",
  "description": "Extensions, walls and boundary walls, concrete slabs, openings in walls, renovation and repairs.",
  "category": "building",
  "keywords": "masonry, building, extension, wall, concrete, slab, foundation, opening, render, house",
  "steps": [
    {
      "id": "service",
      "title": "Your project",
      "fields": [
        {
          "id": "service",
          "type": "choice",
          "label": "What is the project?",
          "required": true,
          "options": [
            { "value": "extension", "label": "An extension" },
            { "value": "new_build", "label": "A new house" },
            { "value": "wall", "label": "A boundary wall or a garden wall" },
            { "value": "slab", "label": "A concrete slab or a terrace" },
            { "value": "opening", "label": "An opening in a wall" },
            { "value": "renovation", "label": "Renovation of an old building" },
            { "value": "repair", "label": "Repairs (cracks, steps, render)" },
            { "value": "other", "label": "Something else" }
          ]
        }
      ]
    },
    {
      "id": "details",
      "title": "A few details",
      "description": "Answer what you can. When you are not sure, choose the closest answer.",
      "fields": [
        {
          "id": "build_area",
          "type": "number",
          "label": "Approximate area",
          "unit": "m²",
          "min": 1,
          "max": 5000,
          "show_if": { "field": "service", "in": [ "extension", "new_build", "slab", "renovation" ] }
        },
        {
          "id": "plans",
          "type": "choice",
          "label": "Do you have plans?",
          "show_if": { "field": "service", "in": [ "extension", "new_build", "renovation" ] },
          "options": [
            { "value": "architect", "label": "Yes, drawn by an architect or a designer" },
            { "value": "sketch", "label": "A sketch" },
            { "value": "none", "label": "Not yet" }
          ]
        },
        {
          "id": "permit",
          "type": "choice",
          "label": "Planning permission",
          "show_if": { "field": "service", "in": [ "extension", "new_build", "wall" ] },
          "options": [
            { "value": "granted", "label": "Granted" },
            { "value": "pending", "label": "In progress" },
            { "value": "not_needed", "label": "Not needed" },
            { "value": "unknown", "label": "I don't know" }
          ]
        },
        {
          "id": "wall_length",
          "type": "number",
          "label": "Approximate length of the wall",
          "unit": "m",
          "min": 1,
          "max": 2000,
          "show_if": { "field": "service", "equals": "wall" }
        },
        {
          "id": "wall_height",
          "type": "number",
          "label": "Height wanted",
          "unit": "m",
          "min": 0.2,
          "max": 5,
          "show_if": { "field": "service", "equals": "wall" }
        },
        {
          "id": "wall_material",
          "type": "choice",
          "label": "Material",
          "show_if": { "field": "service", "equals": "wall" },
          "options": [
            { "value": "blocks", "label": "Concrete blocks, rendered" },
            { "value": "stone", "label": "Stone" },
            { "value": "low_wall", "label": "Low wall with a fence or railing" },
            { "value": "advice", "label": "I would like advice" }
          ]
        },
        {
          "id": "opening_type",
          "type": "choice",
          "label": "Which opening?",
          "show_if": { "field": "service", "equals": "opening" },
          "options": [
            { "value": "door", "label": "A door" },
            { "value": "window", "label": "A window or a bay window" },
            { "value": "between_rooms", "label": "Opening up two rooms" }
          ]
        },
        {
          "id": "load_bearing",
          "type": "choice",
          "label": "Is it a load-bearing wall?",
          "show_if": { "field": "service", "equals": "opening" },
          "options": [
            { "value": "yes", "label": "Yes" },
            { "value": "no", "label": "No" },
            { "value": "unknown", "label": "I don't know" }
          ]
        },
        {
          "id": "opening_width",
          "type": "number",
          "label": "Width wanted",
          "unit": "m",
          "min": 0.5,
          "max": 20,
          "show_if": { "field": "service", "equals": "opening" }
        },
        {
          "id": "repair_details",
          "type": "textarea",
          "label": "What needs to be repaired?",
          "required": true,
          "show_if": { "field": "service", "equals": "repair" }
        },
        {
          "id": "other_request",
          "type": "textarea",
          "label": "Describe what you need",
          "required": true,
          "show_if": { "field": "service", "equals": "other" }
        },
        {
          "id": "access",
          "type": "choice",
          "label": "Access for machines and deliveries",
          "show_if": { "field": "service", "not_in": [ "other", "repair" ] },
          "options": [
            { "value": "easy", "label": "Easy access" },
            { "value": "narrow", "label": "Narrow passage or no access for a truck" },
            { "value": "unknown", "label": "I don't know" }
          ]
        },
        {
          "id": "notes",
          "type": "textarea",
          "label": "Anything else we should know?",
          "placeholder": "Slope, neighbours, a question...",
          "show_if": { "field": "service", "not_in": [ "other" ] }
        }
      ]
    },
    {
      "id": "place",
      "title": "Where is the work?",
      "fields": [
        { "id": "site_address", "type": "address", "label": "Address of the work", "required": true },
        {
          "id": "customer",
          "type": "choice",
          "label": "You are",
          "options": [
            { "value": "owner", "label": "The owner" },
            { "value": "buyer", "label": "Buying the property" },
            { "value": "professional", "label": "An architect or a business" }
          ]
        }
      ]
    },
    {
      "id": "photos",
      "title": "Photos",
      "description": "Photos of the place and, if you have them, of the plans help to prepare the quote faster.",
      "fields": [
        { "id": "photos", "type": "photos", "label": "Photos", "help": "Up to 6 photos. You can take them now with your phone.", "max": 6 }
      ]
    },
    {
      "id": "timing",
      "title": "When?",
      "fields": [
        {
          "id": "timing",
          "type": "choice",
          "label": "When would you like the work done?",
          "required": true,
          "options": [
            { "value": "urgent", "label": "As soon as possible" },
            { "value": "months", "label": "Within the next three months" },
            { "value": "later", "label": "Later this year" },
            { "value": "flexible", "label": "No rush, I am planning ahead" }
          ]
        },
        { "id": "availability", "type": "text", "label": "When can we call you or visit?", "placeholder": "For example weekdays after 5 pm", "maxlength": 150 }
      ]
    }
  ],
  "messages": {
    "success": "Thank you {name}, your request has been sent. We will get back to you soon. A copy has been sent to {email}.",
    "acknowledgement_subject": "Your quote request to {site_name}",
    "acknowledgement_body": "Hello {name},\n\nThank you for your request. We have received it and will contact you soon to talk about your project.\n\nHere is a copy of what you sent us."
  }
}
