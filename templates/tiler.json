{
  "schema": 1,
  "id": "tiler",
  "title": "Tiler",
  "description": "Floor and wall tiling, bathrooms, walk-in showers, terraces, stairs and repairs.",
  "category": "building",
  "keywords": "tiles, tiling, floor, wall tiles, bathroom, walk-in shower, terrace, mosaic, grout",
  "steps": [
    {
      "id": "service",
      "title": "Your project",
      "fields": [
        {
          "id": "service",
          "type": "choice",
          "label": "What is the project?",
          "required": true,
          "options": [
            { "value": "floor", "label": "Floor tiling" },
            { "value": "wall", "label": "Wall tiles (kitchen, walls)" },
            { "value": "bathroom", "label": "Bathroom renovation" },
            { "value": "shower", "label": "Walk-in shower" },
            { "value": "terrace", "label": "Outdoor terrace or pool surround" },
            { "value": "stairs", "label": "Stairs" },
            { "value": "repair", "label": "Replace a few tiles or redo the joints" },
            { "value": "other", "label": "Something else" }
          ]
        }
      ]
    },
    {
      "id": "details",
      "title": "A few details",
      "description": "Answer what you can. If you are not sure, choose \"I don't know\": we will look on site.",
      "fields": [
        {
          "id": "rooms",
          "type": "choice",
          "label": "Which rooms?",
          "help": "Choose all that apply.",
          "multiple": true,
          "show_if": { "field": "service", "in": [ "floor", "wall" ] },
          "options": [
            { "value": "kitchen", "label": "Kitchen" },
            { "value": "living", "label": "Living room or bedroom" },
            { "value": "bathroom", "label": "Bathroom or toilet" },
            { "value": "entrance", "label": "Entrance or corridor" },
            { "value": "whole", "label": "The whole floor of the house" },
            { "value": "other", "label": "Another room" }
          ]
        },
        {
          "id": "bathroom_scope",
          "type": "choice",
          "label": "What is planned in the bathroom?",
          "help": "Choose all that apply.",
          "required": true,
          "multiple": true,
          "show_if": { "field": "service", "equals": "bathroom" },
          "options": [
            { "value": "floor", "label": "Floor" },
            { "value": "walls", "label": "Walls" },
            { "value": "shower", "label": "A walk-in shower" },
            { "value": "bathtub", "label": "Removing the bathtub" },
            { "value": "full", "label": "Complete renovation, plumbing included" }
          ]
        },
        {
          "id": "area",
          "type": "number",
          "label": "Approximate area to tile",
          "unit": "m²",
          "min": 1,
          "max": 2000,
          "help": "A rough idea is enough. Leave it blank if you don't know.",
          "show_if": { "field": "service", "not_in": [ "repair", "other" ] }
        },
        {
          "id": "current_floor",
          "type": "choice",
          "label": "What is on the floor today?",
          "show_if": { "field": "service", "in": [ "floor", "bathroom", "stairs" ] },
          "options": [
            { "value": "slab", "label": "Bare concrete slab" },
            { "value": "tiles_remove", "label": "Old tiles to remove" },
            { "value": "tiles_cover", "label": "Old tiles to tile over" },
            { "value": "wood", "label": "Wooden floor or floorboards" },
            { "value": "vinyl", "label": "Vinyl, lino or carpet" },
            { "value": "unknown", "label": "I don't know" }
          ]
        },
        {
          "id": "underfloor_heating",
          "type": "yesno",
          "label": "Is there underfloor heating?",
          "show_if": { "field": "service", "in": [ "floor", "bathroom" ] }
        },
        {
          "id": "shower_size",
          "type": "text",
          "label": "Approximate size of the shower",
          "placeholder": "For example 120 x 90 cm",
          "show_if": {
            "any": [
              { "field": "service", "equals": "shower" },
              { "field": "bathroom_scope", "in": [ "shower" ] }
            ]
          }
        },
        {
          "id": "replaces_bathtub",
          "type": "yesno",
          "label": "Does the shower replace a bathtub?",
          "show_if": {
            "any": [
              { "field": "service", "equals": "shower" },
              { "field": "bathroom_scope", "in": [ "shower" ] }
            ]
          }
        },
        {
          "id": "terrace_base",
          "type": "choice",
          "label": "What will the tiles be laid on?",
          "required": true,
          "show_if": { "field": "service", "equals": "terrace" },
          "options": [
            { "value": "ground", "label": "Directly on the ground, to prepare" },
            { "value": "slab", "label": "An existing concrete slab" },
            { "value": "pedestals", "label": "Raised slabs on pedestals" },
            { "value": "pool", "label": "Around a swimming pool" },
            { "value": "unknown", "label": "I don't know" }
          ]
        },
        {
          "id": "stairs_count",
          "type": "number",
          "label": "How many steps?",
          "min": 1,
          "max": 100,
          "show_if": { "field": "service", "equals": "stairs" }
        },
        {
          "id": "stairs_place",
          "type": "choice",
          "label": "Indoor or outdoor stairs?",
          "show_if": { "field": "service", "equals": "stairs" },
          "options": [
            { "value": "inside", "label": "Indoor" },
            { "value": "outside", "label": "Outdoor" }
          ]
        },
        {
          "id": "repair_details",
          "type": "textarea",
          "label": "What needs to be repaired?",
          "placeholder": "Number of tiles, cracked joints, a tile that sounds hollow...",
          "required": true,
          "show_if": { "field": "service", "equals": "repair" }
        },
        {
          "id": "spare_tiles",
          "type": "yesno",
          "label": "Do you still have tiles of the same model?",
          "show_if": { "field": "service", "equals": "repair" }
        },
        {
          "id": "tiles",
          "type": "choice",
          "label": "Do you already have the tiles?",
          "show_if": { "field": "service", "not_in": [ "repair", "other" ] },
          "options": [
            { "value": "have", "label": "Yes, I have them" },
            { "value": "chosen", "label": "I have chosen them, not bought yet" },
            { "value": "advice", "label": "No, I would like advice" }
          ]
        },
        {
          "id": "tile_format",
          "type": "choice",
          "label": "Tile format",
          "show_if": { "field": "service", "not_in": [ "repair", "other" ] },
          "options": [
            { "value": "standard", "label": "Standard, up to 60 x 60 cm" },
            { "value": "large", "label": "Large format, over 60 cm" },
            { "value": "plank", "label": "Wood-look planks" },
            { "value": "mosaic", "label": "Mosaic" },
            { "value": "undecided", "label": "Not decided yet" }
          ]
        },
        {
          "id": "other_request",
          "type": "textarea",
          "label": "Describe what you need",
          "required": true,
          "show_if": { "field": "service", "equals": "other" }
        },
        {
          "id": "notes",
          "type": "textarea",
          "label": "Anything else we should know?",
          "placeholder": "Access, furniture to move, a question...",
          "show_if": { "field": "service", "not_in": [ "other" ] }
        }
      ]
    },
    {
      "id": "place",
      "title": "Where is the work?",
      "fields": [
        {
          "id": "site_address",
          "type": "address",
          "label": "Address of the work",
          "required": true
        },
        {
          "id": "building",
          "type": "choice",
          "label": "Type of building",
          "options": [
            { "value": "house", "label": "House" },
            { "value": "apartment", "label": "Apartment" },
            { "value": "new_build", "label": "New build" },
            { "value": "business", "label": "Shop or office" }
          ]
        },
        {
          "id": "customer",
          "type": "choice",
          "label": "You are",
          "options": [
            { "value": "owner", "label": "The owner" },
            { "value": "tenant", "label": "A tenant" },
            { "value": "business", "label": "A business" }
          ]
        }
      ]
    },
    {
      "id": "photos",
      "title": "Photos",
      "description": "Photos help us understand the job and prepare the quote faster. A view of the whole room and a close-up of the floor or wall are ideal.",
      "fields": [
        {
          "id": "photos",
          "type": "photos",
          "label": "Photos of the room",
          "help": "Up to 6 photos. You can take them now with your phone. A photo of the tiles you chose is welcome too.",
          "max": 6
        }
      ]
    },
    {
      "id": "timing",
      "title": "When?",
      "fields": [
        {
          "id": "timing",
          "type": "choice",
          "label": "When would you like the work done?",
          "required": true,
          "options": [
            { "value": "urgent", "label": "As soon as possible" },
            { "value": "months", "label": "Within the next three months" },
            { "value": "flexible", "label": "No rush, I am planning ahead" }
          ]
        },
        {
          "id": "availability",
          "type": "text",
          "label": "When can we call you or visit?",
          "placeholder": "For example weekdays after 5 pm",
          "maxlength": 150
        }
      ]
    }
  ],
  "messages": {
    "success": "Thank you {name}, your request has been sent. We will get back to you soon. A copy has been sent to {email}.",
    "acknowledgement_subject": "Your quote request to {site_name}",
    "acknowledgement_body": "Hello {name},\n\nThank you for your request. We have received it and will contact you soon to talk about your project.\n\nHere is a copy of what you sent us."
  }
}
