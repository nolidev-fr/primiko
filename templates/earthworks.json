{
  "schema": 1,
  "id": "earthworks",
  "title": "Septic systems and earthworks",
  "description": "Septic systems (new and upgrades), sewer connections, earthworks, trenches and networks, outdoor works and digger hire.",
  "category": "outdoor",
  "keywords": "septic tank, sewage, drainage, earthworks, excavation, digger, trench, networks, driveway, groundworks",
  "steps": [
    {
      "id": "service",
      "title": "Your project",
      "fields": [
        {
          "id": "service",
          "type": "choice",
          "label": "What do you need?",
          "required": true,
          "options": [
            { "value": "septic_new", "label": "New septic system (new build)" },
            { "value": "septic_upgrade", "label": "Upgrade an existing septic system" },
            { "value": "septic_repair", "label": "Septic system repair or blockage" },
            { "value": "connection", "label": "Connection to the main sewer" },
            { "value": "earthworks", "label": "Earthworks (house, extension, pool)" },
            { "value": "networks", "label": "Trenches and networks (water, power, rainwater)" },
            { "value": "outdoor", "label": "Outdoor works (driveway, yard, drainage)" },
            { "value": "digger_hire", "label": "Digger hire with operator" },
            { "value": "other", "label": "Something else" }
          ]
        }
      ]
    },
    {
      "id": "details",
      "title": "A few details",
      "description": "Answer what you can. When you are not sure, choose the closest answer: the details are checked on site.",
      "fields": [
        {
          "id": "study",
          "type": "choice",
          "label": "What documents do you have?",
          "help": "For a septic system, the public inspection service (SPANC in France) asks for a soil study, or gives a report after an inspection.",
          "show_if": { "field": "service", "in": [ "septic_new", "septic_upgrade" ] },
          "options": [
            { "value": "soil_study", "label": "A soil study" },
            { "value": "inspection", "label": "An inspection report asking for work" },
            { "value": "none", "label": "Nothing yet" },
            { "value": "unknown", "label": "I don't know" }
          ]
        },
        {
          "id": "property_sale",
          "type": "yesno",
          "label": "Is the work needed after a property sale?",
          "help": "After a sale, the work must usually be done within a year.",
          "show_if": { "field": "service", "equals": "septic_upgrade" }
        },
        {
          "id": "bedrooms",
          "type": "number",
          "label": "How many bedrooms in the house?",
          "help": "The size of the system depends on it.",
          "min": 1,
          "max": 30,
          "show_if": { "field": "service", "in": [ "septic_new", "septic_upgrade" ] }
        },
        {
          "id": "system_type",
          "type": "choice",
          "label": "Type of system wanted",
          "show_if": { "field": "service", "in": [ "septic_new", "septic_upgrade" ] },
          "options": [
            { "value": "traditional", "label": "Traditional: septic tank with a soakaway or a sand filter" },
            { "value": "compact", "label": "Compact system: micro-station or compact filter" },
            { "value": "advice", "label": "I would like advice" }
          ]
        },
        {
          "id": "land_space",
          "type": "choice",
          "label": "Space available on the plot",
          "show_if": { "field": "service", "in": [ "septic_new", "septic_upgrade" ] },
          "options": [
            { "value": "large", "label": "Plenty of room" },
            { "value": "small", "label": "Little room" },
            { "value": "unknown", "label": "I don't know" }
          ]
        },
        {
          "id": "septic_problem",
          "type": "textarea",
          "label": "Describe the problem",
          "placeholder": "Smell, water rising, blocked pipe, an alarm on the micro-station...",
          "required": true,
          "show_if": { "field": "service", "equals": "septic_repair" }
        },
        {
          "id": "sewer_distance",
          "type": "number",
          "label": "Approximate distance between the house and the street",
          "unit": "m",
          "min": 1,
          "max": 1000,
          "show_if": { "field": "service", "equals": "connection" }
        },
        {
          "id": "earthworks_project",
          "type": "choice",
          "label": "What is it for?",
          "required": true,
          "show_if": { "field": "service", "equals": "earthworks" },
          "options": [
            { "value": "house", "label": "A house" },
            { "value": "extension", "label": "An extension or a garage" },
            { "value": "pool", "label": "A swimming pool" },
            { "value": "levelling", "label": "Levelling a plot" },
            { "value": "other", "label": "Something else" }
          ]
        },
        {
          "id": "networks_type",
          "type": "choice",
          "label": "Which networks?",
          "help": "Choose all that apply.",
          "multiple": true,
          "required": true,
          "show_if": { "field": "service", "equals": "networks" },
          "options": [
            { "value": "water", "label": "Drinking water" },
            { "value": "power", "label": "Power or telecom" },
            { "value": "rainwater", "label": "Rainwater" },
            { "value": "drainage", "label": "Drainage" }
          ]
        },
        {
          "id": "outdoor_type",
          "type": "choice",
          "label": "Which works?",
          "help": "Choose all that apply.",
          "multiple": true,
          "required": true,
          "show_if": { "field": "service", "equals": "outdoor" },
          "options": [
            { "value": "driveway", "label": "Driveway or parking area" },
            { "value": "yard", "label": "Yard" },
            { "value": "drainage", "label": "Drainage of a wet area" },
            { "value": "embankment", "label": "Embankment or retaining" },
            { "value": "clearing", "label": "Clearing a plot" }
          ]
        },
        {
          "id": "size",
          "type": "text",
          "label": "Size of the project, if you know it",
          "placeholder": "For example 12 x 10 m, 40 m of trench or 80 m³",
          "show_if": { "field": "service", "in": [ "earthworks", "networks", "outdoor" ] }
        },
        {
          "id": "hire_duration",
          "type": "choice",
          "label": "For how long?",
          "required": true,
          "show_if": { "field": "service", "equals": "digger_hire" },
          "options": [
            { "value": "half_day", "label": "Half a day" },
            { "value": "day", "label": "One day" },
            { "value": "days", "label": "Several days" },
            { "value": "unknown", "label": "I don't know" }
          ]
        },
        {
          "id": "hire_work",
          "type": "textarea",
          "label": "What is the work?",
          "required": true,
          "show_if": { "field": "service", "equals": "digger_hire" }
        },
        {
          "id": "permit",
          "type": "choice",
          "label": "Is there a building permit?",
          "show_if": { "field": "service", "in": [ "septic_new", "earthworks" ] },
          "options": [
            { "value": "yes", "label": "Yes, granted" },
            { "value": "pending", "label": "In progress" },
            { "value": "not_needed", "label": "Not needed" },
            { "value": "unknown", "label": "I don't know" }
          ]
        },
        {
          "id": "access",
          "type": "choice",
          "label": "Access for a digger",
          "help": "It tells us which machine to bring.",
          "show_if": { "field": "service", "not_in": [ "other" ] },
          "options": [
            { "value": "easy", "label": "Easy access" },
            { "value": "narrow", "label": "Narrow passage or gate" },
            { "value": "unknown", "label": "I don't know" }
          ]
        },
        {
          "id": "other_request",
          "type": "textarea",
          "label": "Describe what you need",
          "required": true,
          "show_if": { "field": "service", "equals": "other" }
        },
        {
          "id": "notes",
          "type": "textarea",
          "label": "Anything else we should know?",
          "placeholder": "Slope, wet ground, trees, a question...",
          "show_if": { "field": "service", "not_in": [ "other" ] }
        }
      ]
    },
    {
      "id": "place",
      "title": "Where is the work?",
      "fields": [
        {
          "id": "site_address",
          "type": "address",
          "label": "Address of the work",
          "required": true
        },
        {
          "id": "customer",
          "type": "choice",
          "label": "You are",
          "options": [
            { "value": "individual", "label": "A private individual" },
            { "value": "farmer", "label": "A farmer" },
            { "value": "professional", "label": "A builder, an architect or a business" },
            { "value": "public", "label": "A local authority" }
          ]
        }
      ]
    },
    {
      "id": "photos",
      "title": "Photos",
      "description": "Photos help to understand the job and prepare the quote faster. A view of the plot and of the access are ideal.",
      "fields": [
        {
          "id": "photos",
          "type": "photos",
          "label": "Photos of the site",
          "help": "Up to 6 photos. You can take them now with your phone. A photo of the soil study or of the inspection report is welcome too.",
          "max": 6
        }
      ]
    },
    {
      "id": "timing",
      "title": "When?",
      "fields": [
        {
          "id": "timing",
          "type": "choice",
          "label": "When would you like the work done?",
          "required": true,
          "options": [
            { "value": "urgent", "label": "As soon as possible" },
            { "value": "months", "label": "Within the next three months" },
            { "value": "later", "label": "Later this year" },
            { "value": "flexible", "label": "No rush, I am planning ahead" }
          ]
        },
        {
          "id": "availability",
          "type": "text",
          "label": "When can we call you or visit?",
          "placeholder": "For example weekdays after 5 pm",
          "maxlength": 150
        }
      ]
    }
  ],
  "messages": {
    "success": "Thank you {name}, your request has been sent. We will get back to you soon. A copy has been sent to {email}.",
    "acknowledgement_subject": "Your quote request to {site_name}",
    "acknowledgement_body": "Hello {name},\n\nThank you for your request. We have received it and will contact you soon to talk about your project.\n\nHere is a copy of what you sent us."
  }
}
