{
  "schema": 1,
  "id": "painter",
  "title": "Painter and decorator",
  "description": "Interior painting, facades, wallpaper, woodwork and floor coverings.",
  "category": "building",
  "keywords": "painting, decorating, walls, ceilings, facade, wallpaper, shutters, flooring",
  "steps": [
    {
      "id": "service",
      "title": "Your project",
      "fields": [
        {
          "id": "service",
          "type": "choice",
          "label": "What do you need?",
          "required": true,
          "options": [
            { "value": "interior", "label": "Interior painting" },
            { "value": "facade", "label": "Facade painting or cleaning" },
            { "value": "wallpaper", "label": "Wallpaper" },
            { "value": "woodwork", "label": "Shutters, windows or woodwork" },
            { "value": "floor", "label": "Floor covering (vinyl, laminate, carpet)" },
            { "value": "other", "label": "Something else" }
          ]
        }
      ]
    },
    {
      "id": "details",
      "title": "A few details",
      "description": "Answer what you can. When you are not sure, choose the closest answer.",
      "fields": [
        {
          "id": "rooms",
          "type": "number",
          "label": "How many rooms?",
          "min": 1,
          "max": 50,
          "show_if": { "field": "service", "in": [ "interior", "wallpaper", "floor" ] }
        },
        {
          "id": "surfaces",
          "type": "choice",
          "label": "What should be done?",
          "help": "Choose all that apply.",
          "multiple": true,
          "show_if": { "field": "service", "equals": "interior" },
          "options": [
            { "value": "walls", "label": "Walls" },
            { "value": "ceilings", "label": "Ceilings" },
            { "value": "doors", "label": "Doors and skirting boards" },
            { "value": "stairs", "label": "Stairs or banisters" }
          ]
        },
        {
          "id": "floor_area",
          "type": "number",
          "label": "Approximate floor area of the rooms",
          "unit": "m²",
          "help": "The floor area is enough: we work out the wall area.",
          "min": 1,
          "max": 5000,
          "show_if": { "field": "service", "in": [ "interior", "wallpaper", "floor" ] }
        },
        {
          "id": "condition",
          "type": "choice",
          "label": "How are the walls today?",
          "help": "Choose all that apply.",
          "multiple": true,
          "show_if": { "field": "service", "in": [ "interior", "wallpaper" ] },
          "options": [
            { "value": "good", "label": "In good condition" },
            { "value": "cracks", "label": "Cracks or holes to fill" },
            { "value": "wallpaper", "label": "Wallpaper to remove" },
            { "value": "damp", "label": "Damp or mould" },
            { "value": "unknown", "label": "I don't know" }
          ]
        },
        {
          "id": "facade_height",
          "type": "choice",
          "label": "Height of the building",
          "show_if": { "field": "service", "equals": "facade" },
          "options": [
            { "value": "ground", "label": "Ground floor only" },
            { "value": "one", "label": "One floor above the ground floor" },
            { "value": "two_plus", "label": "Two floors or more" }
          ]
        },
        {
          "id": "facade_material",
          "type": "choice",
          "label": "What is the facade made of?",
          "show_if": { "field": "service", "equals": "facade" },
          "options": [
            { "value": "render", "label": "Render" },
            { "value": "stone", "label": "Stone" },
            { "value": "wood", "label": "Wood cladding" },
            { "value": "unknown", "label": "I don't know" }
          ]
        },
        {
          "id": "facade_area",
          "type": "number",
          "label": "Approximate facade area",
          "unit": "m²",
          "min": 1,
          "max": 10000,
          "show_if": { "field": "service", "equals": "facade" }
        },
        {
          "id": "woodwork_count",
          "type": "text",
          "label": "What should be painted?",
          "placeholder": "For example 6 pairs of shutters and 3 windows",
          "required": true,
          "show_if": { "field": "service", "equals": "woodwork" }
        },
        {
          "id": "floor_type",
          "type": "choice",
          "label": "Which covering?",
          "show_if": { "field": "service", "equals": "floor" },
          "options": [
            { "value": "vinyl", "label": "Vinyl" },
            { "value": "laminate", "label": "Laminate" },
            { "value": "carpet", "label": "Carpet" },
            { "value": "undecided", "label": "Not decided yet" }
          ]
        },
        {
          "id": "colours",
          "type": "choice",
          "label": "Have you chosen the colours or the materials?",
          "show_if": { "field": "service", "not_in": [ "other" ] },
          "options": [
            { "value": "yes", "label": "Yes" },
            { "value": "advice", "label": "No, I would like advice" }
          ]
        },
        {
          "id": "occupied",
          "type": "yesno",
          "label": "Will the rooms be lived in during the work?",
          "show_if": { "field": "service", "in": [ "interior", "wallpaper", "floor" ] }
        },
        {
          "id": "other_request",
          "type": "textarea",
          "label": "Describe what you need",
          "required": true,
          "show_if": { "field": "service", "equals": "other" }
        },
        {
          "id": "notes",
          "type": "textarea",
          "label": "Anything else we should know?",
          "placeholder": "Furniture to move, ceiling height, a question...",
          "show_if": { "field": "service", "not_in": [ "other" ] }
        }
      ]
    },
    {
      "id": "place",
      "title": "Where is the work?",
      "fields": [
        { "id": "site_address", "type": "address", "label": "Address of the work", "required": true },
        {
          "id": "building",
          "type": "choice",
          "label": "Type of building",
          "options": [
            { "value": "house", "label": "House" },
            { "value": "apartment", "label": "Apartment" },
            { "value": "business", "label": "Shop or office" }
          ]
        },
        {
          "id": "customer",
          "type": "choice",
          "label": "You are",
          "options": [
            { "value": "owner", "label": "The owner" },
            { "value": "tenant", "label": "A tenant" },
            { "value": "manager", "label": "A property manager or co-ownership" },
            { "value": "business", "label": "A business" }
          ]
        }
      ]
    },
    {
      "id": "photos",
      "title": "Photos",
      "description": "A view of each room or of the facade helps to prepare the quote faster.",
      "fields": [
        { "id": "photos", "type": "photos", "label": "Photos", "help": "Up to 6 photos. You can take them now with your phone.", "max": 6 }
      ]
    },
    {
      "id": "timing",
      "title": "When?",
      "fields": [
        {
          "id": "timing",
          "type": "choice",
          "label": "When would you like the work done?",
          "required": true,
          "options": [
            { "value": "urgent", "label": "As soon as possible" },
            { "value": "months", "label": "Within the next three months" },
            { "value": "flexible", "label": "No rush, I am planning ahead" }
          ]
        },
        { "id": "availability", "type": "text", "label": "When can we call you or visit?", "placeholder": "For example weekdays after 5 pm", "maxlength": 150 }
      ]
    }
  ],
  "messages": {
    "success": "Thank you {name}, your request has been sent. We will get back to you soon. A copy has been sent to {email}.",
    "acknowledgement_subject": "Your quote request to {site_name}",
    "acknowledgement_body": "Hello {name},\n\nThank you for your request. We have received it and will contact you soon to talk about your project.\n\nHere is a copy of what you sent us."
  }
}
