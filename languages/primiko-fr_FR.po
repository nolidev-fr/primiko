#. Plugin Name of the plugin
#: primiko.php
msgid "Primiko - Quote Requests by Trade"
msgstr "Primiko - Demandes de devis par métier"

#. Plugin URI of the plugin
#: primiko.php
msgid "https://github.com/nolidev-fr/primiko"
msgstr "https://github.com/nolidev-fr/primiko"

#. Description of the plugin
#: primiko.php
msgid "Quote request forms made for each trade: the right questions in the right order, with photos and the site address. Requests are saved in WordPress and sent by email."
msgstr "Des formulaires de demande de devis pensés pour chaque métier : les bonnes questions dans le bon ordre, avec photos et adresse du chantier. Les demandes sont enregistrées dans WordPress et envoyées par e-mail."

